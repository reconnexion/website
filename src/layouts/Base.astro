---
import '../styles/site.css';
import { reglagesSite } from '../lib/contenu';
import Menu from '../components/Menu.astro';
import { Paragraphes } from '../blocs/_commun';

interface Props {
  titre: string;
  description?: string;
}
const { titre, description } = Astro.props;
const site = reglagesSite();
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre === site.nom ? titre : `${titre} · ${site.nom}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    {/* Statistiques de visite (Umami, sans cookies), comptées seulement sur les domaines de production. */}
    <script
      is:inline
      defer
      src="https://stats.reconnexion.coop/script.js"
      data-website-id="6fdebaba-4bc6-466a-bb0c-217428edac61"
      data-domains="reconnexion.coop,new.reconnexion.coop"
    ></script>
  </head>
  <body class="flex min-h-svh flex-col">
    <Menu site={site} chemin={chemin} />
    {/* flex-1 : le pied de page reste en bas de l'écran sur les pages courtes. */}
    <main class="flex-1"><slot /></main>
    <footer class="bg-barre py-e5 text-s text-gris print:hidden">
      <div class="conteneur flex flex-col items-center gap-e3 text-center">
        <Paragraphes texte={site.pied_de_page} />
      </div>
    </footer>
    <script>
      // Rétablit les adresses e-mail masquées aux robots (cf. src/lib/courriel.ts).
      import { devoilerCourriels } from '../lib/courriel';
      devoilerCourriels();

      // Boutons qui ouvrent une modale <dialog> (ex. détail d'un rôle) : data-dialogue="id de la modale".
      document.addEventListener('click', (e) => {
        const bouton = (e.target as Element).closest<HTMLElement>('[data-dialogue]');
        const dialogue = bouton && document.getElementById(bouton.dataset.dialogue!);
        if (dialogue instanceof HTMLDialogElement) dialogue.showModal();
      });
    </script>
  </body>
</html>
