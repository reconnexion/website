---
// Server island : l'agenda est calculé à chaque requête (« aujourd'hui », prochaines occurrences des
// événements récurrents), la page qui l'inclut reste statique. Les événements viennent de la
// collection « Événements » (lus au build).
import { Agenda, type AgendaProps } from '../blocs/Agenda';
import { Calendrier } from '../blocs/_calendrier';
import { tousLesEvenements } from '../lib/contenu';

const props = Astro.props as AgendaProps;
const donnees = {
  fiches: tousLesEvenements(),
  maintenant: new Date().toISOString(),
  lien_ics: new URL('/agenda.ics', Astro.site).href,
};
---
{props.affichage === 'calendrier'
  ? <Calendrier client:load titre={props.titre} texte_vide={props.texte_vide} {...donnees} />
  : <Agenda {...props} {...donnees} />}
