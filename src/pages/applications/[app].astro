---
// Page de chaque application, générée depuis la collection « Applications » (une fiche = une page).
import Base from '../../layouts/Base.astro';
import DiscussionsIle from '../../components/DiscussionsIle.astro';
import UtilisateursIle from '../../components/UtilisateursIle.astro';
import Chargement from '../../components/Chargement.astro';
import RenduBlocs from '../../components/RenduBlocs.astro';
import { FicheApplication } from '../../blocs/FicheApplication';
import { reglagesApplications, reglagesSite, toutesLesApplications, toutesLesPages } from '../../lib/contenu';
import { aUnePage, adresseApplication } from '../../lib/applications';
import sharp from 'sharp';

export function getStaticPaths() {
  // Surtitre : la page qui liste les applications, si elle existe (son titre sert de libellé).
  const liste = toutesLesPages().find((p) => p.slug === 'applications');
  const surtitre = liste ? { texte: liste.titre, lien: '/applications' } : undefined;
  return toutesLesApplications()
    .filter(aUnePage)
    .map((application) => ({ params: { app: application.slug }, props: { application, surtitre } }));
}

const { application: a, surtitre } = Astro.props;
const site = reglagesSite();
const adresse = adresseApplication(a);
// Dimensions des captures (déposées dans public/images/) : la galerie en déduit leur format (ordinateur ou mobile).
const captures = await Promise.all(
  (a.captures ?? []).map(async (c) => {
    if (!c.image.startsWith('/images/')) return c;
    try {
      const { autoOrient } = await sharp(`public${decodeURI(c.image)}`).metadata();
      return { ...c, largeur: autoOrient.width, hauteur: autoOrient.height };
    } catch {
      return c;
    }
  }),
);
---
<Base titre={a.nom} description={a.resume ?? a.accroche}>
  <FicheApplication
    surtitre={surtitre}
    titre={a.nom}
    statut={a.statut}
    logo={a.logo}
    sous_titre={a.accroche}
    boutons={a.boutons}
    captures={captures}
    date_lancement={a.date_lancement}
    description={a.description}
  >
    {adresse && <UtilisateursIle server:defer slot="utilisateurs" adresse={adresse} />}
  </FicheApplication>
  {a.categorie_forum && (
    <DiscussionsIle server:defer categorie={a.categorie_forum}>
      <Chargement slot="fallback" texte={site.texte_chargement} />
    </DiscussionsIle>
  )}
  <RenduBlocs sections={reglagesApplications().sections_bas ?? []} texteChargement={site.texte_chargement} />
</Base>
<script>
  // Visionneuse des captures d'écran (clic sur une capture, flèches, Échap).
  import { installerVisionneuse } from '../../lib/visionneuse';
  installerVisionneuse();
</script>
